{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "background":             { "$value": "hsl(222.2 84% 4.9%)",    "$type": "color" },
    "foreground":             { "$value": "hsl(210 40% 98%)",       "$type": "color" },
    "card":                   { "$value": "hsl(222.2 84% 4.9%)",    "$type": "color" },
    "card-foreground":        { "$value": "hsl(210 40% 98%)",       "$type": "color" },
    "popover":                { "$value": "hsl(222.2 84% 4.9%)",    "$type": "color" },
    "popover-foreground":     { "$value": "hsl(210 40% 98%)",       "$type": "color" },
    "primary":                { "$value": "hsl(210 40% 98%)",       "$type": "color" },
    "primary-foreground":     { "$value": "hsl(222.2 47.4% 11.2%)", "$type": "color" },
    "secondary":              { "$value": "hsl(217.2 32.6% 17.5%)", "$type": "color" },
    "secondary-foreground":   { "$value": "hsl(210 40% 98%)",       "$type": "color" },
    "muted":                  { "$value": "hsl(217.2 32.6% 17.5%)", "$type": "color" },
    "muted-foreground":       { "$value": "hsl(215 20.2% 65.1%)",   "$type": "color" },
    "accent":                 { "$value": "hsl(217.2 32.6% 17.5%)", "$type": "color" },
    "accent-foreground":      { "$value": "hsl(210 40% 98%)",       "$type": "color" },
    "destructive":            { "$value": "hsl(0 62.8% 30.6%)",     "$type": "color" },
    "destructive-foreground": { "$value": "hsl(210 40% 98%)",       "$type": "color" },
    "border":                 { "$value": "hsl(217.2 32.6% 17.5%)", "$type": "color" },
    "input":                  { "$value": "hsl(217.2 32.6% 17.5%)", "$type": "color" },
    "ring":                   { "$value": "hsl(212.7 26.8% 83.9%)", "$type": "color" }
  },
  "radius": {
    "base": { "$value": "0.5rem",                                 "$type": "dimension" },
    "lg":   { "$value": "{radius.base}",                          "$type": "dimension" },
    "md":   { "$value": "calc({radius.base} - 2px)",              "$type": "dimension" },
    "sm":   { "$value": "calc({radius.base} - 4px)",              "$type": "dimension" }
  }
}
